diff --git a/src/SimulatorLifecycle.cpp b/src/SimulatorLifecycle.cpp
index f3ab960..317e7b0 100644
--- a/src/SimulatorLifecycle.cpp
+++ b/src/SimulatorLifecycle.cpp
@@ -5,6 +5,7 @@
 #include <cstdlib>
 #include <cstring>
 #include <unistd.h>
+#include <string>
 
 namespace {
 
@@ -17,6 +18,30 @@ constexpr const char *kScreenshotsAfterWakeEnv =
     "CROSSPOINT_SIM_SCREENSHOTS_AFTER_WAKE";
 char **gArgv = nullptr;
 
+#if defined(__APPLE__)
+extern char rtcSectionStart __asm("section$start$__DATA$__rtc_noinit");
+extern char rtcSectionEnd __asm("section$end$__DATA$__rtc_noinit");
+#else
+extern char __start_rtc_noinit[] __attribute__((weak));
+extern char __stop_rtc_noinit[] __attribute__((weak));
+#endif
+
+void rtcBounds(char *&begin, size_t &size) {
+#if defined(__APPLE__)
+  begin = &rtcSectionStart;
+  size = static_cast<size_t>(&rtcSectionEnd - &rtcSectionStart);
+#else
+  begin = __start_rtc_noinit;
+  size = __start_rtc_noinit ? static_cast<size_t>(__stop_rtc_noinit - __start_rtc_noinit) : 0;
+#endif
+}
+
+constexpr const char *kRestartEnv = "CROSSPOINT_SIM_RESTART";
+constexpr const char *kRtcImageEnv = "CROSSPOINT_SIM_RTC_IMAGE";
+constexpr const char *kBootCountEnv = "CROSSPOINT_SIM_BOOT";
+constexpr const char *kInputScriptAfterRestartEnv = "CROSSPOINT_SIM_INPUT_SCRIPT_AFTER_RESTART";
+constexpr const char *kScreenshotsAfterRestartEnv = "CROSSPOINT_SIM_SCREENSHOTS_AFTER_RESTART";
+
 void promoteAfterWakeValue(const char *target, const char *afterWake) {
   const char *value = std::getenv(afterWake);
   if (value) {
@@ -69,4 +94,49 @@ WakeReason consumeWakeReason() {
   _exit(1);
 }
 
+void softwareRestart() {
+  const char *mode = std::getenv(kRestartEnv);
+  if (!mode || std::strcmp(mode, "exec") != 0 || !gArgv || !gArgv[0]) {
+    return;  // upstream behaviour: ESP.restart() is a no-op
+  }
+  char *begin = nullptr;
+  size_t size = 0;
+  rtcBounds(begin, size);
+  const char *dir = std::getenv("TMPDIR");
+  std::string path = std::string(dir && *dir ? dir : "/tmp") + "/crosspoint-sim-rtc-" + std::to_string(getpid()) + ".bin";
+  if (FILE *f = std::fopen(path.c_str(), "wb")) {
+    if (size) std::fwrite(begin, 1, size, f);
+    std::fclose(f);
+    setenv(kRtcImageEnv, path.c_str(), 1);
+  }
+  const char *boot = std::getenv(kBootCountEnv);
+  setenv(kBootCountEnv, std::to_string((boot ? std::atoi(boot) : 0) + 1).c_str(), 1);
+  // Like a deep-sleep wake, never replay the pre-restart schedule.
+  promoteAfterWakeValue(kInputScriptEnv, kInputScriptAfterRestartEnv);
+  promoteAfterWakeValue(kScreenshotsEnv, kScreenshotsAfterRestartEnv);
+  unsetenv(kInputScriptAfterWakeEnv);
+  unsetenv(kScreenshotsAfterWakeEnv);
+  std::fprintf(stderr, "[SIM] software restart: relaunching (rtc %zu bytes)\n", size);
+  std::fflush(nullptr);
+  execvp(gArgv[0], gArgv);
+  std::perror("execvp");
+  _exit(1);
+}
+
+void restoreRtcImage() {
+  const char *path = std::getenv(kRtcImageEnv);
+  if (!path) return;
+  char *begin = nullptr;
+  size_t size = 0;
+  rtcBounds(begin, size);
+  if (FILE *f = std::fopen(path, "rb")) {
+    const size_t got = size ? std::fread(begin, 1, size, f) : 0;
+    std::fclose(f);
+    std::fprintf(stderr, "[SIM] software restart: boot %s, restored %zu/%zu rtc bytes\n",
+                 std::getenv(kBootCountEnv) ? std::getenv(kBootCountEnv) : "?", got, size);
+  }
+  std::remove(path);
+  unsetenv(kRtcImageEnv);
+}
+
 } // namespace SimulatorLifecycle
