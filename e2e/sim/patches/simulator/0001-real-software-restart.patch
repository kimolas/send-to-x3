Subject: [PATCH] Emulate ESP.restart() as a real relaunch (opt-in)

crosspoint-simulator 5b38077 makes ESP.restart()/esp_restart() a no-op and
RTC_NOINIT_ATTR plain globals, so the firmware's silent restart (a reboot that
keeps a few RTC variables, e.g. "reopen the reader") continues in the same
process. With CROSSPOINT_SIM_RESTART=exec the simulator instead:

- keeps RTC_NOINIT_ATTR variables in their own section (__DATA,__rtc_noinit on
  macOS, rtc_noinit elsewhere), saves it to $TMPDIR and restores it in main()
  before setup(), like the ESP32's RTC memory across a software reset;
- swaps in CROSSPOINT_SIM_INPUT_SCRIPT_AFTER_RESTART and
  CROSSPOINT_SIM_SCREENSHOTS_AFTER_RESTART (the pre-restart schedule is never
  replayed, as after a deep-sleep wake) and drops the *_AFTER_WAKE schedules;
- prints "[SIM] software restart: relaunching (rtc N bytes)" and execvp()s
  itself (same pid and stdout), then "[SIM] software restart: boot N,
  restored X/Y rtc bytes" in the new process;
- marks the listening sockets close-on-exec so a relaunch can bind them again.

Without the variable ESP.restart() stays a no-op (upstream behaviour).
Used by send-to-x3 e2e/sim/build_sim.sh (--sim-patch; the "fork" build).

diff --git a/src/Arduino.h b/src/Arduino.h
index ec5e2e8..5105f21 100644
--- a/src/Arduino.h
+++ b/src/Arduino.h
@@ -16,7 +16,13 @@
 #define ICACHE_RODATA_ATTR
 #define IRAM_ATTR
 #define DRAM_ATTR
-#define RTC_NOINIT_ATTR
+// RTC_NOINIT variables live in their own section so an emulated software reset
+// (CROSSPOINT_SIM_RESTART=exec) can carry them into the relaunched process.
+#if defined(__APPLE__)
+#define RTC_NOINIT_ATTR __attribute__((section("__DATA,__rtc_noinit"), used))
+#else
+#define RTC_NOINIT_ATTR __attribute__((section("rtc_noinit"), used))
+#endif
 #define SET_LOOP_TASK_STACK_SIZE(bytes)
 #define PGM_P const char *
 #define PSTR(s) (s)
@@ -47,6 +53,8 @@ inline int digitalRead(int /*pin*/) { return 1; }
 #include "Print.h"
 #include "WString.h"
 
+namespace SimulatorLifecycle { void softwareRestart(); }
+
 struct ESPMock {
   static constexpr uint32_t HEAP_SIZE = 1024 * 1024;
 
@@ -64,7 +72,7 @@ struct ESPMock {
   }
 
   uint32_t getFreeHeap() { return heapValue("CROSSPOINT_SIM_FREE_HEAP"); }
-  void restart() {}
+  void restart() { SimulatorLifecycle::softwareRestart(); }  // no-op unless CROSSPOINT_SIM_RESTART=exec
   uint32_t getHeapSize() { return HEAP_SIZE; }
   uint32_t getMinFreeHeap() { return getFreeHeap(); }
   uint32_t getMaxAllocHeap() {
