+// ESP.restart()/esp_restart(): with CROSSPOINT_SIM_RESTART=exec, saves the
+// RTC_NOINIT section and relaunches the process (same pid, same stdout);
+// otherwise returns (upstream no-op).
+void softwareRestart();
+// Called by main() before setup(): restores a saved RTC_NOINIT image.
+void restoreRtcImage();
 
 }  // namespace SimulatorLifecycle
