+  EXPECT_EQ(fetchAction(false, true, true, true), FetchAction::Download);
+}
+
+TEST(PluginCatalogOpen, BundlesAndOtherFilesKeepTheDownloadScreen) {
+  EXPECT_EQ(fetchAction(true, false, false, false), FetchAction::Download);  // bundle row
+  EXPECT_EQ(fetchAction(true, true, false, true), FetchAction::Download);    // e.g. a .pdf already on the card
+}
+
+TEST(PluginCatalogOpen, ABookOnTheCardOpensWithoutADownload) {
+  EXPECT_EQ(fetchAction(true, true, true, true), FetchAction::OpenExisting);
+}
+
+TEST(PluginCatalogOpen, ANewBookDownloadsThenOpens) {
+  EXPECT_EQ(fetchAction(true, true, true, false), FetchAction::DownloadThenOpen);
+}
+
+// The Confirm label reads Open exactly on the rows that open in the reader.
+TEST(PluginCatalogOpen, TheOpenLabelMatchesTheAction) {
+  for (int bits = 0; bits < 16; ++bits) {
+    const bool open = bits & 1, singleFile = bits & 2, readerBook = bits & 4, onCard = bits & 8;
+    EXPECT_EQ(opensInReader(open, singleFile, readerBook),
+              fetchAction(open, singleFile, readerBook, onCard) != FetchAction::Download)
+        << "bits " << bits;
+  }
+  EXPECT_FALSE(opensInReader(true, false, true));  // bundle row: Fetch
+  EXPECT_FALSE(opensInReader(true, true, false));  // e.g. a .pdf: Fetch
+}
+
+TEST(PluginCatalogOpen, CapabilityIsAdvertised) {
+  EXPECT_NE(std::string_view(firmwareidentity::PLUGIN_CAPABILITIES).find("catalog.open_after_download"),
+            std::string_view::npos);
+}
