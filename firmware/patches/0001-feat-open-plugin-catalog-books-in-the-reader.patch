+bool PluginCatalogActivity::bookDestination(const Item& item, std::string& dest) {
+  const std::string folderDir = downloadDir();
+  const char* folder = folderDir.c_str();
+  bool haveFolder = folder[0] != '\0';
+  if (haveFolder && !Storage.exists(folder) && !Storage.mkdir(folder)) {
+    LOG_ERR("PCAT", "mkdir failed for %s, using SD root", folder);
+    haveFolder = false;
+  }
+
+  // Sanitize after substitution so the byte limit applies to the complete
+  // filename and does not remove an extension already present in {title}.
+  const std::string filename =
+      StringUtils::sanitizeFilenamePreservingExtension(substituted(manifest.filenameTpl, &item));
+  if (filename.empty() || filename.find("..") != std::string::npos || filename.find('/') != std::string::npos) {
+    LOG_ERR("PCAT", "unsafe filename rejected: %s", filename.c_str());
+    return false;
+  }
+  dest.clear();
+  dest.reserve((haveFolder ? folderDir.size() : 0) + 1 + filename.size());
+  if (haveFolder) dest += folder;
+  dest += '/';
+  dest += filename;
+  if (!protectedpaths::isPluginPath(dest)) {
+    LOG_ERR("PCAT", "unsafe download dest rejected: %s", dest.c_str());
+    return false;
+  }
+  return true;
+}
+
+bool PluginCatalogActivity::rowOpensInReader(const Item& item) const {
+  const bool singleFile = !(manifest.isBundle() && !item.files.empty());
+  // downloadItem() checks the destination's extension, which is the filename's.
+  // Catalogs without download.open skip the string work (the footer asks on
+  // every render).
+  const bool readerBook =
+      manifest.openAfterDownload && singleFile &&
+      isReaderBook(StringUtils::sanitizeFilenamePreservingExtension(substituted(manifest.filenameTpl, &item)));
+  return plugincatalogopen::opensInReader(manifest.openAfterDownload, singleFile, readerBook);
+}
+
+// The same clean-heap reboot every Wi-Fi screen does on exit, into the reader
+// instead of Home (as KOReader sync and the loan-time check return to a book).
+bool PluginCatalogActivity::openDownloadedBook(const std::string& path, const bool sendEvents) {
+  const std::string previous = APP_STATE.openEpubPath;
+  APP_STATE.openEpubPath = path;
+  if (!APP_STATE.saveToFile()) {
+    // The reboot would reopen whatever state.json names; the caller falls back.
+    LOG_ERR("PCAT", "Cannot record the book to open: %s", path.c_str());
+    APP_STATE.openEpubPath = previous;
+    return false;
+  }
+  LOG_INF("PCAT", "Opening in the reader: %s", path.c_str());
+  session.reset();  // free the browse TLS session before the event requests
+  // Report the new book.downloaded now rather than at the next Wi-Fi join. A
+  // copy already on the card queued nothing, and the join that opened the
+  // catalog already drained, so only a fresh download sends.
+  if (sendEvents && wifiConnected()) {
+    // Each event is an HTTPS request (up to the 30 s timeout): show Loading
+    // first. A render still queued from the progress bar paints Loading too.
+    {
+      RenderLock lock;
+      state = State::LOADING;
+      statusMessage = tr(STR_LOADING);
+      GUI.drawPopup(renderer, tr(STR_LOADING_POPUP));
+      // Same heap preparation as a download (the caches repopulate on demand).
+      if (auto* fcm = renderer.getFontCacheManager()) fcm->releaseSdFontCaches();
+    }
+    if (ESP.getFreeHeap() >= HttpDownloader::MIN_TLS_FREE_HEAP &&
+        ESP.getMaxAllocHeap() >= HttpDownloader::MIN_TLS_MAX_ALLOC) {
+      pluginevents::drain(nullptr);
+    } else {
+      // Queued events wait for the next Wi-Fi join.
+      LOG_ERR("PCAT", "Low heap for plugin events (%u free, %u max block)", ESP.getFreeHeap(), ESP.getMaxAllocHeap());
+    }
+  }
+  Storage.remove(BROWSE_TMP_PATH);  // onExit, which removes it, is skipped by the reboot
+  WiFi.disconnect(false);
+  delay(30);
+  {
+    // Runs from the loop task with no lock held; the restart popup paints
+    // straight to the panel, so keep the render task off the framebuffer.
+    RenderLock lock;
+    silentRestartToReader();
+  }
+  // Only reached when sleep superseded the reboot (and in the simulator).
+  activityManager.goToReader(path);
+  return true;
+}
