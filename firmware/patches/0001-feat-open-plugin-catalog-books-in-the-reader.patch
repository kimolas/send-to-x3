+  const bool zip = file.read(magic, sizeof(magic)) == static_cast<int>(sizeof(magic)) && magic[0] == 'P' &&
+                   magic[1] == 'K' && magic[2] == 3 && magic[3] == 4;
+  file.close();
+  return zip;
+}
