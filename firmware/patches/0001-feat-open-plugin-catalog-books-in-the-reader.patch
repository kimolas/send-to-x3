+
+// A usable copy is already at `path`. An .epub must start like a ZIP, so an error
+// page a server saved under the book's name is downloaded again, not reopened.
+bool bookOnCard(const std::string& path) {
+  if (!FsHelpers::hasEpubExtension(std::string_view(path))) return Storage.exists(path.c_str());
