index 0000000..a62a5d4
--- /dev/null
+++ b/src/activities/plugins/PluginCatalogOpen.h
@@ -0,0 +1,27 @@
+#pragma once
+
+#include <cstdint>
+
+namespace plugincatalogopen {
+
+// What Confirm on a catalog row does when the manifest sets download.open.
+enum class FetchAction : uint8_t {
+  Download,          // the stock flow: download, then the "Download complete" screen
+  OpenExisting,      // the book is already on the card: open it as is, no request
+  DownloadThenOpen,  // download, then open the new copy
+};
+
+// download.open applies to single-file rows whose destination the reader opens.
+// Those rows label Confirm Open; every other row keeps Fetch.
+constexpr bool opensInReader(const bool openAfterDownload, const bool singleFile, const bool readerBook) {
+  return openAfterDownload && singleFile && readerBook;
+}
+
+// A copy already on the card keeps its layout cache and reading position.
+constexpr FetchAction fetchAction(const bool openAfterDownload, const bool singleFile, const bool readerBook,
+                                  const bool onCard) {
+  if (!opensInReader(openAfterDownload, singleFile, readerBook)) return FetchAction::Download;
+  return onCard ? FetchAction::OpenExisting : FetchAction::DownloadThenOpen;
+}
+
+}  // namespace plugincatalogopen
